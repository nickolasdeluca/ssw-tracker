---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SSW Tracking">
  <!-- Search Section -->
  <section class="search-section">
    <div class="card search-card">
      <div class="card-header">
        <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 6-9 13-9 13S3 16 3 10a9 9 0 1 1 18 0z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <h1>SSW Tracking</h1>
      </div>
      <p class="subtitle">Rastreie sua encomenda pela chave da nota fiscal eletrônica</p>

      <div class="input-group">
        <input
          type="text"
          id="chaveNfe"
          placeholder="Insira a chave NFe (44 dígitos)"
          maxlength="44"
          autocomplete="off"
        />
        <span class="char-count" id="charCount">0/44</span>
      </div>

      <label class="checkbox-label">
        <input type="checkbox" id="autoRefresh" />
        <span class="checkmark"></span>
        Consultar automaticamente a cada 10 minutos
      </label>

      <button id="trackBtn" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        Rastrear
      </button>
    </div>
  </section>

  <!-- Loading Spinner -->
  <div id="loadingSpinner" class="spinner-container hidden">
    <div class="spinner"></div>
    <p>Consultando rastreamento...</p>
  </div>

  <!-- Results Section -->
  <section id="resultsSection" class="results-section hidden">
    <!-- Header Info Card -->
    <div class="card info-card">
      <h2>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
          <rect x="1" y="3" width="15" height="13" rx="2" />
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
          <circle cx="5.5" cy="18.5" r="2.5" />
          <circle cx="18.5" cy="18.5" r="2.5" />
        </svg>
        Dados da Remessa
      </h2>
      <div class="info-grid">
        <div class="info-item">
          <span class="info-label">Remetente</span>
          <span class="info-value" id="remetente">—</span>
        </div>
        <div class="info-item">
          <span class="info-label">Destinatário</span>
          <span class="info-value" id="destinatario">—</span>
        </div>
        <div class="info-item">
          <span class="info-label">Nº Nota Fiscal</span>
          <span class="info-value" id="nroNf">—</span>
        </div>
        <div class="info-item">
          <span class="info-label">Nº Pedido</span>
          <span class="info-value" id="pedido">—</span>
        </div>
      </div>
    </div>

    <!-- Tracking Timeline -->
    <div class="card tracking-card">
      <h2>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
        </svg>
        Rastreamento
      </h2>

      <!-- Desktop Table -->
      <div class="table-wrapper desktop-only">
        <table id="trackingTable">
          <thead>
            <tr>
              <th>Data/Hora</th>
              <th>Cidade</th>
              <th>Situação</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="trackingTableBody"></tbody>
        </table>
      </div>

      <!-- Mobile Timeline -->
      <div class="timeline mobile-only" id="trackingTimeline"></div>
    </div>
  </section>

  <!-- Modal -->
  <div id="infoModal" class="modal-overlay hidden">
    <div class="modal">
      <div class="modal-header">
        <h3>Detalhes do Rastreio</h3>
        <button class="modal-close" id="modalClose" aria-label="Fechar">&times;</button>
      </div>
      <div class="modal-body" id="modalBody"></div>
      <div class="modal-footer">
        <button class="btn btn-secondary" id="modalCloseBtn">Fechar</button>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toastContainer" class="toast-container"></div>
</Layout>

<script>
  const chaveInput = document.getElementById('chaveNfe') as HTMLInputElement;
  const charCount = document.getElementById('charCount')!;
  const trackBtn = document.getElementById('trackBtn')!;
  const autoRefreshCb = document.getElementById('autoRefresh') as HTMLInputElement;
  const loadingSpinner = document.getElementById('loadingSpinner')!;
  const resultsSection = document.getElementById('resultsSection')!;
  const trackingTableBody = document.getElementById('trackingTableBody')!;
  const trackingTimeline = document.getElementById('trackingTimeline')!;
  const infoModal = document.getElementById('infoModal')!;
  const modalBody = document.getElementById('modalBody')!;
  const modalClose = document.getElementById('modalClose')!;
  const modalCloseBtn = document.getElementById('modalCloseBtn')!;
  const toastContainer = document.getElementById('toastContainer')!;

  // Header fields
  const remetenteEl = document.getElementById('remetente')!;
  const destinatarioEl = document.getElementById('destinatario')!;
  const nroNfEl = document.getElementById('nroNf')!;
  const pedidoEl = document.getElementById('pedido')!;

  let autoRefreshTimer: ReturnType<typeof setInterval> | null = null;

  // Restore saved key
  const savedKey = localStorage.getItem('chaveNfe');
  if (savedKey) {
    chaveInput.value = savedKey;
    charCount.textContent = `${savedKey.length}/44`;
  }

  // Input handling
  chaveInput.addEventListener('input', () => {
    charCount.textContent = `${chaveInput.value.length}/44`;
    localStorage.setItem('chaveNfe', chaveInput.value);
  });

  chaveInput.addEventListener('paste', (e) => {
    e.preventDefault();
    const text = (e.clipboardData?.getData('text/plain') ?? '')
      .replace(/\s/g, '')
      .replace(/\n/g, '')
      .replace(/\t/g, '');
    chaveInput.value = text;
    charCount.textContent = `${text.length}/44`;
    localStorage.setItem('chaveNfe', text);
  });

  // Enter key to submit
  chaveInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') requestTrackingData();
  });

  // Track button
  trackBtn.addEventListener('click', requestTrackingData);

  // Auto-refresh
  autoRefreshCb.addEventListener('change', () => {
    if (autoRefreshCb.checked) {
      requestTrackingData();
      autoRefreshTimer = setInterval(() => {
        requestTrackingData();
      }, 600000);
    } else {
      if (autoRefreshTimer) {
        clearInterval(autoRefreshTimer);
        autoRefreshTimer = null;
      }
    }
  });

  // Modal
  modalClose.addEventListener('click', closeModal);
  modalCloseBtn.addEventListener('click', closeModal);
  infoModal.addEventListener('click', (e) => {
    if (e.target === infoModal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  function closeModal() {
    infoModal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function openModal(item: any) {
    const fields = [
      { label: 'Data/Hora', value: item.data_hora },
      { label: 'Data/Hora Efetiva', value: item.data_hora_efetiva },
      { label: 'Cidade', value: item.cidade },
      { label: 'Descrição', value: item.descricao },
      { label: 'Domínio', value: item.dominio },
      { label: 'Filial', value: item.filial },
      { label: 'Nome do Recebedor', value: item.nome_recebedor || 'Não informado' },
      { label: 'Documento do Recebedor', value: item.nro_doc_recebedor || 'Não informado' },
      { label: 'Ocorrência', value: item.ocorrencia },
      { label: 'Tipo', value: item.tipo },
    ];

    modalBody.innerHTML = fields
      .map(
        (f) => `
        <div class="modal-field">
          <span class="modal-label">${f.label}</span>
          <span class="modal-value">${escapeHtml(String(f.value ?? '—'))}</span>
        </div>`
      )
      .join('');

    infoModal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Toast
  function showToast(message: string, type: 'success' | 'error' | 'warning') {
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;

    const icons: Record<string, string> = {
      success: '✓',
      error: '✕',
      warning: '⚠',
    };

    toast.innerHTML = `
      <span class="toast-icon">${icons[type]}</span>
      <span class="toast-message">${escapeHtml(message)}</span>
    `;
    toastContainer.appendChild(toast);

    requestAnimationFrame(() => toast.classList.add('toast-visible'));

    setTimeout(() => {
      toast.classList.remove('toast-visible');
      toast.addEventListener('transitionend', () => toast.remove());
    }, 5000);
  }

  function formatDate(dateStr: string): string {
    try {
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return dateStr;
      return d.toLocaleDateString('pt-BR') + ' ' + d.toLocaleTimeString('pt-BR');
    } catch {
      return dateStr;
    }
  }

  async function requestTrackingData() {
    const chaveNfe = chaveInput.value.trim();

    if (!chaveNfe) {
      showToast('Informe a chave da nota fiscal eletrônica!', 'warning');
      return;
    }

    if (chaveNfe.length !== 44) {
      showToast('A chave da NFe deve conter exatamente 44 dígitos!', 'error');
      return;
    }

    resultsSection.classList.add('hidden');
    loadingSpinner.classList.remove('hidden');

    try {
      const response = await fetch('https://ssw.inf.br/api/trackingdanfe', {
        method: 'POST',
        mode: 'cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ chave_nfe: chaveNfe }),
      });

      const data = await response.json();

      if (data.success === false) {
        loadingSpinner.classList.add('hidden');
        showToast(`Erro: ${data.message}`, 'error');
        return;
      }

      const header = data.documento.header;
      const tracking = data.documento.tracking;

      // Format dates
      tracking.forEach((item: any) => {
        item.data_hora = formatDate(item.data_hora);
        item.data_hora_efetiva = formatDate(item.data_hora_efetiva);
      });

      // Populate header
      remetenteEl.textContent = header.remetente || '—';
      destinatarioEl.textContent = header.destinatario || '—';
      nroNfEl.textContent = header.nro_nf || '—';
      pedidoEl.textContent = header.pedido || '—';

      // Populate desktop table
      trackingTableBody.innerHTML = tracking
        .map(
          (item: any, i: number) => `
          <tr>
            <td>${escapeHtml(item.data_hora_efetiva)}</td>
            <td>${escapeHtml(item.cidade)}</td>
            <td>${escapeHtml(item.descricao)}</td>
            <td>
              <button class="btn btn-sm btn-info" data-index="${i}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="12" y1="16" x2="12" y2="12" />
                  <line x1="12" y1="8" x2="12.01" y2="8" />
                </svg>
                Detalhes
              </button>
            </td>
          </tr>`
        )
        .join('');

      // Populate mobile timeline
      trackingTimeline.innerHTML = tracking
        .map(
          (item: any, i: number) => `
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-date">${escapeHtml(item.data_hora_efetiva)}</span>
              <span class="timeline-city">${escapeHtml(item.cidade)}</span>
              <span class="timeline-status">${escapeHtml(item.descricao)}</span>
              <button class="btn btn-sm btn-info" data-index="${i}">Detalhes</button>
            </div>
          </div>`
        )
        .join('');

      // Attach info button listeners
      document.querySelectorAll('[data-index]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-index')!);
          openModal(tracking[idx]);
        });
      });

      loadingSpinner.classList.add('hidden');
      resultsSection.classList.remove('hidden');
      showToast('Rastreamento consultado com sucesso!', 'success');
    } catch (err) {
      loadingSpinner.classList.add('hidden');
      showToast('Erro ao consultar o rastreamento. Tente novamente.', 'error');
      console.error(err);
    }
  }
</script>
